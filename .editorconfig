# Root EditorConfig file
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Java files — follow Google Java Format rules
[*.java]
indent_size = 2
max_line_length = 100

# XML files (commonly used in Spring Boot configs)
[*.xml]
indent_size = 2

# YAML (application.yml)
[*.yml]
indent_size = 2

# JSON files
[*.json]
indent_size = 2

# Markdown
[*.md]
trim_trailing_whitespace = false

# Properties files
[*.properties]
indent_size = 2

# Gitignore
[.gitignore]
insert_final_newline = false
